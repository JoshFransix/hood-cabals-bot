# From @BotFather
BOT_TOKEN=

# Local: docker compose up -d db
DATABASE_URL=postgres://cabal:cabal@localhost:5432/cabal

# Where the wallet-link page is reachable. Locally this is http://localhost:3000;
# in production it must be your https domain.
PUBLIC_URL=http://localhost:3000
PORT=3000

# Robinhood Chain mainnet. The public RPC is rate limited; swap in a
# QuickNode/Alchemy URL for production.
RPC_URL=https://rpc.mainnet.chain.robinhood.com
CHAIN_ID=4663
NFT_CONTRACT=0x32303e62bb2f0ab0db2ca36d4a93307dd23bbd3a

# Private groups per tier. Add the bot to each as an admin with
# "Invite users" and "Ban users" rights, then put the chat IDs here.
TIER_HOOD_CHAT_ID=
TIER_CABAL_CHAT_ID=
TIER_INNER_CHAT_ID=

# Daily holder re-check, cron syntax (UTC)
RECHECK_CRON=17 4 * * *

# VPS only: password for the Postgres container
POSTGRES_PASSWORD=cabal
