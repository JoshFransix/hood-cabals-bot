# From @BotFather
BOT_TOKEN=

# Local: docker compose up -d db
DATABASE_URL=postgres://cabal:cabal@localhost:5432/cabal

# Where the wallet-link page is reachable. Locally this is http://localhost:3000;
# in production it must be your https domain.
PUBLIC_URL=http://localhost:3000
PORT=3000

# Robinhood Chain mainnet. The public RPC is rate limited; swap in a
# QuickNode/Alchemy URL for production.
RPC_URL=https://rpc.mainnet.chain.robinhood.com
CHAIN_ID=4663
NFT_CONTRACT=0x32303e62bb2f0ab0db2ca36d4a93307dd23bbd3a

# Private groups per tier. Add the bot to each as an admin with
# "Invite users" and "Ban users" rights, then put the chat IDs here.
TIER_HOOD_CHAT_ID=
TIER_CABAL_CHAT_ID=
TIER_INNER_CHAT_ID=

# Optional: an open community group. Not gated, but verified holders get their
# tier tag there. The bot needs admin with "Edit Member Tags".
COMMUNITY_CHAT_ID=

# Daily holder re-check, cron syntax (UTC)
RECHECK_CRON=17 4 * * *

# --- Alerts ---
# The relay's group. Add this bot there as admin (no rights needed) and /chatid it.
INTAKE_CHAT_ID=
# Optional: only accept intake messages from the relay's Telegram user id
INTAKE_FROM_ID=
# Free key from helius.dev, for tracking Solana wallets
HELIUS_API_KEY=
# Telegram user ids allowed to /track wallets, comma-separated. Get yours with /myid.
ADMIN_IDS=
# Minutes after Inner Circle that Cabal and Hood get each alert
ALERT_DELAY_CABAL_MIN=2
ALERT_DELAY_HOOD_MIN=10
# Skip tokens with less liquidity than this (USD)
ALERT_MIN_LIQUIDITY=10000
# Weekly recap, cron syntax (UTC)
RECAP_CRON=43 16 * * 1

# VPS only: password for the Postgres container
POSTGRES_PASSWORD=cabal
